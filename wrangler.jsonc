// Cloudflare Workers config: serves the static site in public/ (no server code).
// public/_headers (CSP, HSTS, …) is applied to every response.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./public"
  },
  // One public address only: no *.workers.dev copy, no per-version preview links
  "workers_dev": false,
  "preview_urls": false,
  // Attach the site to the domain; Cloudflare creates the DNS records and HTTPS certificate.
  "routes": [
    { "pattern": "nehemiaslandaverde.com", "custom_domain": true },
    { "pattern": "www.nehemiaslandaverde.com", "custom_domain": true }
  ]
}
